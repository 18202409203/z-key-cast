{
  "name": "z-key-cast",
  "version": "1.5.3",
  "description": "Corner HUD for keyboard and mouse actions while screen recording",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:build:internal": "node scripts/tauri-build-internal.mjs",
    "website:dev": "pnpm --filter z-key-cast-website dev",
    "website:build": "pnpm --filter z-key-cast-website build",
    "website:check": "pnpm --filter z-key-cast-website check",
    "site:sync-web": "node website/scripts/site-sync-web.mjs",
    "site:serve": "node website/scripts/site-serve.mjs",
    "site:publish-artifacts": "node website/scripts/site-publish.mjs",
    "site:publish-test": "node website/scripts/site-publish.mjs --test",
    "release": "release-kit",
    "release:patch": "release-kit patch",
    "release:minor": "release-kit minor",
    "release:major": "release-kit major",
    "changelog": "release-kit changelog"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@zhupengji/release-kit": "^0.1.4",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
