# Copy to website/.env (gitignored) and adjust for your LAN.
#
# Used by:
#   pnpm tauri:build:internal
#   pnpm site:publish-artifacts / site:publish-test
#   pnpm site:serve (prints the URL)

UPDATE_BASE_URL=http://127.0.0.1:4173

# Optional override for the test signing private key
# (default: website/keys/updater.test.key)
# TAURI_SIGNING_PRIVATE_KEY_PATH=website/keys/updater.test.key
