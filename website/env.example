# Copy to website/.env (gitignored).
#
# Public one-shot: pnpm site:dist
# Test one-shot:   pnpm site:dist-test
#                  pnpm site:serve-test
#
# website:build is shared. Pages are the same; only the publish root differs.

# HTTPS origin for website/publish/ (no trailing slash).
UPDATE_BASE_URL=https://z-key-cast.1224777638.workers.dev

# LAN origin for website/publish-test/ and test updater builds (no trailing slash).
UPDATE_BASE_URL_TEST=http://127.0.0.1:4173

# Optional override for the test signing private key
# (default: updater-keys/updater.test.key)
# TAURI_SIGNING_PRIVATE_KEY_PATH=updater-keys/updater.test.key
